<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.edu.co.proyectofinal.VentanaPrincipalController"
            prefWidth="1440"
            prefHeight="900"
            style="-fx-background-color: #F3F6FB;">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="245"
              spacing="8"
              style="-fx-background-color: #14243D;">

            <padding>
                <Insets top="28" right="15" bottom="22" left="15"/>
            </padding>

            <Label text="APARTA-SUITES UQ"
                   style="-fx-text-fill: white;
                          -fx-font-size: 21px;
                          -fx-font-weight: bold;"/>

            <Label text="Sistema de Gestión de Alojamiento"
                   wrapText="true"
                   style="-fx-text-fill: #9FB1CB;
                          -fx-font-size: 11px;"/>

            <Separator style="-fx-padding: 12 0 8 0;"/>

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-text-fill: #8195B1;
                          -fx-font-size: 11px;
                          -fx-padding: 8 10;"/>

            <Button fx:id="btnMenuInicio"
                    text="Inicio"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: #25466E;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 9;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuReservas"
                    text="Panel de reservas"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuCalendario"
                    text="Calendario de ocupación"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuUsuario"
                    text="Panel de usuario"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuPreparacion"
                    text="Panel de preparación"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuMapa"
                    text="Mapa interactivo"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuEstadisticas"
                    text="Estadísticas"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnMenuCargaDatos"
                    text="Carga de datos"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #C9D5E6;
                           -fx-padding: 13 14;"/>

            <Button fx:id="btnCambiarRol" text="Cambiar de rol"
                    maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: #25466E; -fx-text-fill: white; -fx-padding: 13 14;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5"
                  style="-fx-background-color: #1D3555;
                         -fx-background-radius: 10;
                         -fx-padding: 14;">

                <Label text="APARTA-SUITES UQ"
                       style="-fx-text-fill: white;
                              -fx-font-weight: bold;"/>

                <Label text="Salento, Quindío"
                       style="-fx-text-fill: #9FB1CB;
                              -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENIDO -->
    <center>
        <VBox>

            <!-- BARRA SUPERIOR -->
            <HBox prefHeight="65"
                  alignment="CENTER_LEFT"
                  spacing="12"
                  style="-fx-background-color: white;
                         -fx-border-color: #E6EBF2;
                         -fx-border-width: 0 0 1 0;">

                <padding>
                    <Insets left="28" right="28"/>
                </padding>

                <Label text="Inicio / Tablero de apartamentos"
                       style="-fx-text-fill: #697B91;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Aparta-Suites UQ"
                       style="-fx-text-fill: #273D58;
                              -fx-font-weight: bold;"/>
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS">

                <content>
                    <VBox spacing="22"
                          style="-fx-background-color: #F3F6FB;
                                 -fx-padding: 26;">

                        <VBox spacing="6">
                            <Label text="Tablero de apartamentos"
                                   style="-fx-font-size: 27px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #172B48;"/>

                            <Label text="Consulta el estado operativo de todos los apartamentos."
                                   style="-fx-text-fill: #718197;"/>
                        </VBox>

                        <!-- RESUMEN -->
                        <HBox spacing="12">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;">

                                <Label text="TOTAL APARTAMENTOS"
                                       style="-fx-text-fill: #718197;"/>

                                <Label fx:id="lblTotalApartamentos"
                                       text="—"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #172B48;"/>
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;">

                                <Label text="PREPARADOS"
                                       style="-fx-text-fill: #718197;"/>

                                <Label fx:id="lblPreparados"
                                       text="—"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #23965D;"/>
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;">

                                <Label text="OCUPADOS"
                                       style="-fx-text-fill: #718197;"/>

                                <Label fx:id="lblOcupados"
                                       text="—"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #2463A6;"/>
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;">

                                <Label text="EN PREPARACIÓN"
                                       style="-fx-text-fill: #718197;"/>

                                <Label fx:id="lblEnPreparacion"
                                       text="—"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #C9981B;"/>
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 12;
                                         -fx-padding: 18;">

                                <Label text="FUERA DE SERVICIO"
                                       style="-fx-text-fill: #718197;"/>

                                <Label fx:id="lblFueraServicio"
                                       text="—"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #D44B4B;"/>
                            </VBox>
                        </HBox>

                        <!-- TABLERO -->
                        <VBox spacing="18"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 22;">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="12">

                                <Label text="Estado de apartamentos"
                                       style="-fx-font-size: 19px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #172B48;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="btnActualizarTablero"
                                        text="Actualizar tablero"
                                        style="-fx-background-color: #2463A6;
                                               -fx-text-fill: white;"/>
                            </HBox>

                            <!-- LEYENDA -->
                            <FlowPane hgap="22" vgap="10">

                                <Label text="● Preparado"
                                       style="-fx-text-fill: #23965D;
                                              -fx-font-weight: bold;"/>

                                <Label text="● Ocupado"
                                       style="-fx-text-fill: #2463A6;
                                              -fx-font-weight: bold;"/>

                                <Label text="● Pendiente de preparación"
                                       style="-fx-text-fill: #C9981B;
                                              -fx-font-weight: bold;"/>

                                <Label text="● En preparación"
                                       style="-fx-text-fill: #C9981B;
                                              -fx-font-weight: bold;"/>

                                <Label text="● Fuera de servicio"
                                       style="-fx-text-fill: #D44B4B;
                                              -fx-font-weight: bold;"/>
                            </FlowPane>

                            <Separator/>

                            <!-- FILTROS -->
                            <HBox spacing="12"
                                  alignment="CENTER_LEFT">

                                <TextField fx:id="txtBuscarApartamento"
                                           promptText="Buscar por código o nombre"
                                           prefWidth="240"/>

                                <ComboBox fx:id="cmbFiltrarEstado"
                                          promptText="Filtrar por estado"
                                          prefWidth="210"/>

                                <ComboBox fx:id="cmbFiltrarBloque"
                                          promptText="Filtrar por bloque"
                                          prefWidth="170"/>

                                <Button fx:id="btnLimpiarFiltros"
                                        text="Limpiar filtros"/>
                            </HBox>

                            <!-- CONTENEDOR DE TARJETAS -->
                            <Label text="Vista general del edificio"
                                   style="-fx-font-size: 15px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #172B48;"/>

                            <FlowPane fx:id="panelApartamentos"
                                      hgap="14"
                                      vgap="14"
                                      prefWrapLength="900">

                                <!--
                                    Los apartamentos reales se
                                    mostrarán aquí desde el controlador.
                                    No se incluyen datos ficticios.
                                -->

                            </FlowPane>

                            <Label text="Los apartamentos aparecerán aquí al cargar los datos del sistema."
                                   style="-fx-text-fill: #718197;"/>

                        </VBox>

                        <!-- DETALLE -->
                        <VBox spacing="12"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;">

                            <Label text="Detalle del apartamento seleccionado"
                                   style="-fx-font-size: 18px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #172B48;"/>

                            <GridPane hgap="20" vgap="12">

                                <children>
                                    <Label text="Código:"
                                           GridPane.rowIndex="0"/>

                                    <Label fx:id="lblDetalleCodigo"
                                           text="—"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>

                                    <Label text="Bloque:"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="0"/>

                                    <Label fx:id="lblDetalleBloque"
                                           text="—"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="0"/>

                                    <Label text="Piso:"
                                           GridPane.rowIndex="1"/>

                                    <Label fx:id="lblDetallePiso"
                                           text="—"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                    <Label text="Capacidad:"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="1"/>

                                    <Label fx:id="lblDetalleCapacidad"
                                           text="—"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="1"/>

                                    <Label text="Estado:"
                                           GridPane.rowIndex="2"/>

                                    <Label fx:id="lblDetalleEstado"
                                           text="—"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                                    <Label text="Motivo fuera de servicio:"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="2"/>

                                    <Label fx:id="lblMotivoFueraServicio"
                                           text="—"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="2"/>
                                </children>
                            </GridPane>

                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
